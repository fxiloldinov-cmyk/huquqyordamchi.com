# Netlify -> Site configuration -> Environment variables bo'limida sozlang.
# Bu qiymatlarni ommaviy GitHub repozitoriyga yoki ZIP arxivga yozmang.
GEMINI_API_KEY=
# Modelni provayderning amaldagi ro'yxatiga qarab sozlang.
GEMINI_MODEL=gemini-2.5-flash
# Ixtiyoriy: ruxsat etilgan domenlar (vergul bilan). Bo'sh bo'lsa — faqat saytning o'z domeni.
ALLOWED_ORIGINS=
